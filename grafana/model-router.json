          },
          "expr": "sum by (route_fact_retry_source) (increase(model_router_fact_sources_total{route_fact_retry_source!=\"\"}[$__range]))",
          "legendFormat": "retry · {{route_fact_retry_source}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "I",
          "datasource": {
