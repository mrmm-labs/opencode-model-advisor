          },
          "expr": "sum by (route_fact_kind_source) (increase(model_router_fact_sources_total{route_fact_kind_source!=\"\"}[$__range]))",
          "legendFormat": "kind · {{route_fact_kind_source}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
