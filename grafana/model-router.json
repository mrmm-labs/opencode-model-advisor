          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?task(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "task",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?risk(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "risk",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?files(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "files",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?modules(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "modules",
          "range": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?kind(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "kind",
          "range": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?migration(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "migration",
          "range": true
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?unknowns(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "unknowns",
          "range": true
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?retry(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "retry",
          "range": true
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?priorFailures(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "priorFailures",
          "range": true
        },
        {
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?promptTokens(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "promptTokens",
          "range": true
        },
        {
          "refId": "K",
          "datasource": {
