          },
          "expr": "sum (increase(model_router_disagreement_facts_total{route_disagreement_facts=~\"(.*,)?paths(,.*)?\"}[$__rate_interval]))",
          "legendFormat": "paths",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Fact source mix (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
