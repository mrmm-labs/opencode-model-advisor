          },
          "expr": "sum by (route_fact_priorFailures_source) (increase(model_router_fact_sources_total{route_fact_priorFailures_source!=\"\"}[$__range]))",
          "legendFormat": "priorFailures · {{route_fact_priorFailures_source}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "J",
          "datasource": {
