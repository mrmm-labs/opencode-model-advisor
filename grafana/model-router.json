            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (route_fact_task_source) (increase(model_router_fact_sources_total{route_fact_task_source!=\"\"}[$__range]))",
          "legendFormat": "task · {{route_fact_task_source}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (route_fact_risk_source) (increase(model_router_fact_sources_total{route_fact_risk_source!=\"\"}[$__range]))",
          "legendFormat": "risk · {{route_fact_risk_source}}",
